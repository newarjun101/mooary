// Same reasoning as Debug: a missing Local.xcconfig is a parse error, so the include is optional.
#include? "../Local.xcconfig"

FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../composeApp/build/bin/iosSimulatorArm64/releaseFramework $(SRCROOT)/../composeApp/build/bin/iosArm64/releaseFramework

// SQLDelight drives SQLite through a cinterop, so the Kotlin framework *references*
// _sqlite3_* but does not bundle the library. Without this the link fails with a wall of
// "Undefined symbols ... _sqlite3_bind_blob" and nothing in that output mentions SQLite.
// It is a system library, so -l resolves it; no .tbd needs checking in.
OTHER_LDFLAGS = $(inherited) -framework ComposeApp -lsqlite3

ENABLE_USER_SCRIPT_SANDBOXING = NO
